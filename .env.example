# KindProxy HTTP/HTTPS residential proxy (sticky session recommended for consistent region)
KP_PROXY_SERVER=http://gw.kindproxy.com:12000
KP_PROXY_USERNAME=YOUR_PROXY_USERNAME
KP_PROXY_PASSWORD=YOUR_PROXY_PASSWORD

# Amazon product URL
AMAZON_URL=https://www.amazon.com/dp/B0GF9MJY9W

# Use a stable identifier for product/variant/purchase type; do NOT include a hard-coded ZIP.
# The script detects the current ZIP and compares only matching locations.
CONTEXT_KEY=amazon-us:fig-cedarwood:26floz:one-time
PRICE_CONTAINER_SELECTOR=#corePriceDisplay_desktop_feature_div .priceToPay

# Operator-provided assumptions (not automatically verified from the page)
VERIFIED_CURRENCY=USD
VERIFIED_SELLER=Amazon.com

NAVIGATION_TIMEOUT_MS=60000
DEBUG=0
OUTPUT_DIR=output
